{
  "manifest_version": 3,
  "name": "FocusPilot",
  "version": "1.0.0",
  "version_name": "1.0.0 (development)",
  "description": "Blocks the sites in your FocusPilot rules, during focus sessions and on schedules.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "spanning",
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "FocusPilot"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
