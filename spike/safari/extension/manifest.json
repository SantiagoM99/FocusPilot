{
  "manifest_version": 3,
  "name": "FocusPilot Spike S1",
  "version": "0.0.25",
  "description": "Throwaway spike: Safari enforces a focus policy without the app.",
  "background": {
    "scripts": [
      "policy.js",
      "background.js"
    ]
  },
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "policy.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "FocusPilot Spike S1",
    "default_popup": "popup.html",
    "default_icon": "toolbar-icon.svg"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js"
      ],
      "matches": [
        "*://*.instagram.com/*",
        "*://*.youtube.com/*"
      ]
    }
  ]
}
