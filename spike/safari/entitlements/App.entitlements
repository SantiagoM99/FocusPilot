<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed, matching the Developer ID direct-distribution plan. No App Group by
	     default: an ad-hoc "group." claim makes every store access a consent prompt
	     (SPIKE_NOTES.md, Permission prompts). build.sh with the app-group flag adds it back. -->
</dict>
</plist>
