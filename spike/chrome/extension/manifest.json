{
  "manifest_version": 3,
  "name": "FocusPilot Spike S2",
  "version": "0.0.2",
  "description": "Throwaway spike S2/S3: native messaging, DNR policy, lifecycle observations, already-open pages.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "spanning",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "action": {
    "default_title": "FocusPilot Spike S2",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.example.com/*",
    "*://*.example.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "match.js",
        "cs.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.example.com/*",
        "*://*.example.org/*"
      ]
    }
  ]
}
