{
  "manifest_version": 3,
  "name": "FocusPilot Spike S2",
  "version": "0.0.1",
  "description": "Throwaway spike: native messaging, DNR policy, lifecycle observations.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "spanning",
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "action": {
    "default_title": "FocusPilot Spike S2",
    "default_popup": "popup.html"
  }
}
